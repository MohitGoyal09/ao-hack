LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_FAST_MODEL=gemini/gemini-2.5-flash
LITELLM_STRONG_MODEL=gemini/gemini-2.5-pro
LITELLM_FAST_ALIAS=covenant-fast
LITELLM_STRONG_ALIAS=covenant-strong

# Supabase project: ao-hack (Mumbai, ap-south-1).
