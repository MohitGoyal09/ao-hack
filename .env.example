# Web to API connection. This value is read by the Next.js server.
AGENT_URL=http://localhost:8123

# Model provider. Keep API keys server-side.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase configuration. Use the direct or session-pooler connection for the
# persistent Python API. Use a separate direct URL for migrations if required.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=covenant-private

# Neatlogs configuration will be completed from its generated project setup.
NEATLOGS_ENABLED=false
NEATLOGS_WORKFLOW_NAME=covenant-certificate

# Optional CopilotKit managed services.
CPK_INTELLIGENCE_API_KEY=
