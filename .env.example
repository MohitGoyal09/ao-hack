SUPABASE_PROJECT_REF=hbgnqhnwudazsyzfevox
SUPABASE_URL=https://hbgnqhnwudazsyzfevox.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_2LHgN7M2aDVBg0TAbwloTw_bgkAvp0i
NEXT_PUBLIC_SUPABASE_URL=https://hbgnqhnwudazsyzfevox.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_2LHgN7M2aDVBg0TAbwloTw_bgkAvp0i

# Use Supavisor session mode for the current long-running Python API if its host
# lacks IPv6. Use the direct connection for migrations and admin operations.
# Serverless deployments should use transaction mode on port 6543 instead.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=covenant-private

# Neatlogs configuration will be completed from its generated project setup.
NEATLOGS_ENABLED=false
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
