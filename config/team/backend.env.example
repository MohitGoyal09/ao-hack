# Copy to the repository root as .env. Never commit the filled file.
AGENT_URL=http://localhost:8123

# Supabase public project values.
SUPABASE_PROJECT_REF=hbgnqhnwudazsyzfevox
SUPABASE_URL=https://hbgnqhnwudazsyzfevox.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_2LHgN7M2aDVBg0TAbwloTw_bgkAvp0i
SUPABASE_STORAGE_BUCKET=covenant-private

# Offline demo only: drain the in-memory job store from a thread inside the API
# process so uploads progress without a separate worker. Default 1. Ignored when
# DATABASE_URL is set (run `python -m src.platform.worker` instead).
INPROCESS_WORKER=1

# Server-only Supabase values. Obtain these from the team password manager.
SUPABASE_SECRET_KEY=

# URL-encode the database password before inserting it in a URL.
# Current long-running API/worker: Supavisor session pooler, IPv4 compatible.
DATABASE_URL=postgresql://postgres.hbgnqhnwudazsyzfevox:YOUR_DATABASE_PASSWORD_URL_ENCODED@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Migrations/admin: direct connection, IPv6 unless the IPv4 add-on is enabled.
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD_URL_ENCODED@db.hbgnqhnwudazsyzfevox.supabase.co:5432/postgres?sslmode=require

# Isolated test database only; never use the shared production project here.
TEST_DATABASE_URL=

# Model provider (OpenAI-compatible; the agent uses ChatOpenAI). Keep API keys server-side.
# Empty LITELLM_API_KEY = no model call; the copilot runs the offline deterministic LangGraph path.
#
# Option A - NVIDIA NIM directly (any tool-calling model on build.nvidia.com):
#   LITELLM_API_KEY=nvapi-...
#   LITELLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LITELLM_STRONG_ALIAS=moonshotai/kimi-k2-instruct
#   (docker-compose pins LITELLM_BASE_URL to the litellm container; override it for the api service.)
#
# Option B - Gemini through the optional LiteLLM proxy (docker compose service `litellm`):
#   GEMINI_API_KEY=..., LITELLM_MASTER_KEY=..., LITELLM_API_KEY=<same as master key>,
#   LITELLM_BASE_URL=http://litellm:4000/v1, LITELLM_STRONG_ALIAS=covenant-strong
GEMINI_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_FAST_MODEL=gemini/gemini-2.5-flash
LITELLM_STRONG_MODEL=gemini/gemini-2.5-pro
LITELLM_FAST_ALIAS=covenant-fast
LITELLM_STRONG_ALIAS=covenant-strong

# Optional observability and CopilotKit services. Server-only.
NEATLOGS_ENABLED=false
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=covenant-certificate
CPK_INTELLIGENCE_API_KEY=

# Hosted demo identity (scripts/seed_demo_identity.py creates these; docs/hosted-setup.md).
# DEMO_ORG_ID is the org slug. Passwords live only in the filled root .env, never in git.
DEMO_ORG_ID=demo-treasury
DEMO_OFFICER_EMAIL=
DEMO_OFFICER_PASSWORD=
DEMO_REVIEWER_EMAIL=
DEMO_REVIEWER_PASSWORD=
