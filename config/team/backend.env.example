# URL-encode the database password before inserting it in a URL.
# Current long-running API/worker: Supavisor session pooler, IPv4 compatible.
DATABASE_URL=postgresql://postgres.hbgnqhnwudazsyzfevox:YOUR_DATABASE_PASSWORD_URL_ENCODED@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Migrations/admin: direct connection, IPv6 unless the IPv4 add-on is enabled.
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD_URL_ENCODED@db.hbgnqhnwudazsyzfevox.supabase.co:5432/postgres?sslmode=require

# Isolated test database only; never use the shared production project here.
TEST_DATABASE_URL=

# Gemini through LiteLLM. Server-only.
GEMINI_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_FAST_MODEL=gemini/gemini-2.5-flash
LITELLM_STRONG_MODEL=gemini/gemini-2.5-pro
LITELLM_FAST_ALIAS=covenant-fast
LITELLM_STRONG_ALIAS=covenant-strong

# Optional observability and CopilotKit services. Server-only.
NEATLOGS_ENABLED=false
